# ── Core ────────────────────────────────────────────────────────────────
# Postgres (Neon, Supabase, RDS...) for production. Leave empty to run in
# demo mode: embedded Postgres (PGlite) — file-backed locally, in-memory on serverless.
DATABASE_URL=

# Secrets used to sign sessions and encrypt BYOK keys. SET THESE IN PRODUCTION.
SESSION_SECRET=change-me-64-random-chars
MASTER_KEY=change-me-64-random-chars

# Wallet that receives user USDC/USDG deposits (your platform treasury wallet).
PLATFORM_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000

# Platform margin on brokered inference, in percent (default 10).
PLATFORM_MARGIN_PCT=10

# ── Provider keys (platform-brokered inference). Any OpenAI-based provider. ──
# Users can also bring their own keys (BYOK) in the dashboard.
PROV_OPENAI_API_KEY=
PROV_ANTHROPIC_API_KEY=
PROV_GROQ_API_KEY=
PROV_DEEPSEEK_API_KEY=

# ── Autonomous agents ────────────────────────────────────────────────────
# Wallet (private key) that pays x402 per-call invoices on Base. Fund it with USDC.
AGENT_WALLET_PRIVATE_KEY=

# Secret required by POST /api/cron/agents (Vercel Cron etc.)
CRON_SECRET=change-me
