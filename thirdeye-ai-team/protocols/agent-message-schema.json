{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "task_id",
    "from_agent",
    "to_agent",
    "message_type",
    "created_at",
    "payload"
  ],
  "properties": {
    "message_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "from_agent": {
      "type": "string"
    },
    "to_agent": {
      "type": "string"
    },
    "message_type": {
      "enum": [
        "task_assignment",
        "handoff",
        "question",
        "answer",
        "blocker",
        "review_request",
        "approval_request",
        "status_update",
        "cancel"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_response": {
      "type": "boolean"
    }
  }
}
