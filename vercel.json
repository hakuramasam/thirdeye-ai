{
  "buildCommand": "npm run build:web",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/.well-known/agent-card.json",
      "destination": "/api"
    },
    {
      "source": "/a2a",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/agents",
      "schedule": "30 18 * * *"
    }
  ]
}