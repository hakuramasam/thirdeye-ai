{
  "id": "backend",
  "name": "BACKEND",
  "role": "backend_database_engineer",
  "version": "1.0.0",
  "system_prompt": "system.md",
  "description": "Implements APIs, persistence, authorization hooks, jobs, and backend services.",
  "ownership": "Owns backend code, data access, migrations proposals, and API tests.",
  "collaborators": [
    "hermes",
    "architect",
    "frontend",
    "intelligence",
    "agent-engineer",
    "blockchain",
    "sentinel",
    "qa",
    "devops",
    "docs"
  ],
  "permissions": {
    "summary": "May modify backend code and propose migrations. Destructive migrations and production data operations require human approval.",
    "mode": "least_privilege",
    "server_side_enforcement_required": true
  },
  "limits": {
    "default_timeout_seconds": 1200,
    "max_retries": 2,
    "tool_calls_per_task": 40
  },
  "approval_required": [
    "production_deploy",
    "destructive_migration",
    "wallet_sign_or_broadcast",
    "fund_transfer_or_sweep",
    "contract_deployment",
    "financial_policy_change",
    "security_exception"
  ],
  "memory_namespace": "project:thirdeye:agents:backend"
}
