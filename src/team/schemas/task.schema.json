{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "project_id",
    "title",
    "objective",
    "owner",
    "created_by",
    "status",
    "priority",
    "acceptance_criteria",
    "created_at"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "const": "thirdeye-ai"
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "objective": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "owner": {
      "enum": [
        "hermes",
        "product",
        "architect",
        "frontend",
        "backend",
        "intelligence",
        "agent-engineer",
        "blockchain",
        "sentinel",
        "qa",
        "devops",
        "docs"
      ]
    },
    "created_by": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "assigned",
        "in_progress",
        "blocked",
        "review",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_expectations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string"
    }
  }
}
