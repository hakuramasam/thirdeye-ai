{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "agent_id",
    "status",
    "summary",
    "evidence",
    "tests",
    "risks",
    "created_at"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed",
        "review_required"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "result"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "not_run"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "description"
        ],
        "properties": {
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "description": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
