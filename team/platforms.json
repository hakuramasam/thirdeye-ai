{
  "version": 1,
  "source_of_truth": {
    "roster": "team/organization.json",
    "authority": "team/policies/authority.md",
    "role_knowledge": "team/agents/<role>/SKILL.md",
    "pipelines": "team/pipelines/",
    "workflows": "team/workflows/",
    "task_contract": "src/team/schemas/task.schema.json",
    "message_contract": "src/team/schemas/agent-message.schema.json",
    "report_contract": "src/team/schemas/agent-report.schema.json"
  },
  "platforms": {
    "codex": {
      "instructions": "AGENTS.md",
      "skills": ".agents/skills/",
      "agents": ".codex/agents/<role>.toml"
    },
    "claude_code": {
      "instructions": "CLAUDE.md",
      "skills": ".claude/skills/",
      "agents": ".claude/agents/<role>.md"
    },
    "cursor": {
      "instructions": "AGENTS.md",
      "rules": ".cursor/rules/thirdeye-team.mdc"
    },
    "github_copilot": {
      "instructions": ".github/copilot-instructions.md",
      "agents": ".github/agents/<role>.agent.md"
    },
    "gemini_cli": {
      "instructions": "GEMINI.md",
      "skills": ".agents/skills/"
    },
    "github_actions": {
      "ci": ".github/workflows/ci.yml",
      "neon_lifecycle": ".github/workflows/neon-preview-branch-expiry.yml",
      "controlled_preview": ".github/workflows/controlled-vercel-preview.yml",
      "dependabot": ".github/dependabot.yml",
      "pull_request_template": ".github/PULL_REQUEST_TEMPLATE.md",
      "issue_template": ".github/ISSUE_TEMPLATE/agent-task.yml"
    }
  },
  "tool_authority": {
    "principle": "Platform profiles describe task focus and expose only necessary host tools; they do not grant application permissions.",
    "runtime_enforced": [
      "repo_read",
      "repo_write",
      "delegate_to_agent",
      "http_fetch",
      "read_artifact",
      "namespaced_mcp_tools",
      "x402_payment_policy"
    ],
    "write_rule": "The runner adds repo_write when run-level allowWrite=true or the agent record has repo_access=write. The team authority policy requires task-scoped grants; persisted write entitlements must be treated as high risk and approved by the owner. The server enforces agent/* branches, allowlisted paths, size/file caps and credential checks; it opens PRs and never merges.",
    "external_mcp": "Only explicitly configured MCP servers with approved public hosts may be used. No provider credentials or endpoints are embedded in this repository."
  },
  "verification": {
    "typecheck": "npm run typecheck",
    "tests": "env -u DATABASE_URL -u DATABASE_URL_UNPOOLED npm test",
    "web_build": "npm run build:web",
    "platform_config": "node scripts/validate-agent-platforms.mjs"
  },
