{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thirdeye-ai.invalid/schemas/authority-evaluation.schema.json",
  "title": "Thirdeye Agent Authority Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluation_id", "correlation_id", "run_id", "task_id", "agent_id", "agent_role", "requested_capability", "risk_tier", "repository", "head_sha", "decision", "policy_version", "created_at"],
  "properties": {
    "evaluation_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "parent_run_id": { "type": ["string", "null"] },
    "task_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": ["string", "null"] },
    "stage_id": { "type": ["string", "null"] },
    "agent_id": { "type": "string", "minLength": 1 },
    "agent_role": { "type": "string", "minLength": 1 },
    "agent_version": { "type": ["string", "null"] },
    "requested_capability": { "type": "string", "minLength": 1 },
    "resource_scope": { "type": ["string", "null"] },
    "environment": { "enum": ["local", "test", "preview", "staging", "production"] },
    "risk_tier": { "enum": ["low", "medium", "high", "critical", "prohibited"] },
    "risk_reasons": { "type": "array", "items": { "type": "string" } },
    "repository": { "type": "string", "minLength": 1 },
    "branch": { "type": ["string", "null"] },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "base_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "changed_paths_digest": { "type": ["string", "null"] },
    "workflow_run_ids": { "type": "array", "items": { "type": "string" } },
    "required_check_names": { "type": "array", "items": { "type": "string" } },
    "check_conclusions": { "type": "object", "additionalProperties": { "enum": ["success", "failure", "cancelled", "skipped", "neutral", "timed_out", "action_required", "stale", "missing"] } },
    "test_artifact_digests": { "type": "array", "items": { "type": "string" } },
    "postgres_version": { "type": ["string", "null"] },
    "database_mode": { "enum": ["postgres", "pglite", "sqlite", "unknown"] },
    "preview_deployment_id": { "type": ["string", "null"] },
    "preview_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "smoke_result": { "enum": ["passed", "failed", "not_run", "blocked"] },
    "reviewer_ids": { "type": "array", "items": { "type": "string" } },
    "reviewed_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "review_decisions": { "type": "array", "items": { "enum": ["approved", "changes_requested", "commented", "pending"] } },
    "security_report_id": { "type": ["string", "null"] },
    "financial_report_id": { "type": ["string", "null"] },
    "owner_approval_id": { "type": ["string", "null"] },
    "owner_approved_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "owner_approval_scope": { "type": ["string", "null"] },
    "decision": { "enum": ["ELIGIBLE", "BLOCKED", "EXPIRED", "REVOKED"] },
    "blocker_codes": { "type": "array", "items": { "type": "string" } },
    "evidence_digest": { "type": ["string", "null"] },
    "grant_id": { "type": ["string", "null"] },
    "grant_scope": { "type": ["string", "null"] },
    "max_amount": { "type": ["integer", "null"], "minimum": 0 },
    "rate_limits": { "type": ["object", "null"] },
    "policy_version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" },
    "revocation_reason": { "type": ["string", "null"] },
    "audit_event_id": { "type": ["string", "null"] }
  }
}